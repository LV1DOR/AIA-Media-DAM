# Placeholder configuration; never paste real values into this file.
AIA_API_PORT=4100
AIA_BIND=127.0.0.1
AIA_DATA_DIR=.local/app-data
AIA_MEDIA_ORIGIN=http://localhost:3100
AIA_TRANSFER_ORIGIN=http://localhost:3101
AIA_SECURE_COOKIES=false
AIA_RS_URL=http://localhost:18088
AIA_GOKAPI_URL=http://localhost:53842
# Runtime requires AIA_MASTER_KEY, AIA_BOOTSTRAP_PASSWORD, AIA_RS_USER,
# AIA_RS_KEY and AIA_GOKAPI_KEY from private environment/secret configuration.
# NAS production also uses AIA_RS_PROVISION_USER and AIA_RS_PROVISION_KEY
# for the separate native account-management identity. Never use real NAS
# credentials or media in an untrusted development environment.
