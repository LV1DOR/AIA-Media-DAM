# separately under docs/images using synthetic media and public artwork.
docs/**/evidence/**/*.png
docs/**/evidence/**/*.jpg
docs/**/evidence/**/*.jpeg
docs/**/evidence/**/*.webp
docs/**/evidence/**/*.zip
